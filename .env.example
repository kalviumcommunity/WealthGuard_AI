# WealthGuard AI Environment Configuration
# Copy this file to .env and fill in the required values
# DO NOT commit the actual .env file to version control

# ============================================
# API Configuration
# ============================================

# Backend API URL (for Streamlit frontend)
RAG_API_URL=http://localhost:8000

# ============================================
# Model Configuration
# ============================================

# Embedding model name (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chat model (if using OpenAI or similar)
# OPENAI_API_KEY=your_api_key_here
# CHAT_MODEL=gpt-4o-mini

# ============================================
# Vector Database Configuration
# ============================================

# Vector database path (ChromaDB persistent storage)
VECTOR_DB_PATH=./vector_db/chroma_data

# Collection name for document chunks
VECTOR_COLLECTION=wealthguard_chunks

# ============================================
# Application Configuration
# ============================================

# Maximum file upload size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# Allowed file extensions for upload
ALLOWED_EXTENSIONS=.txt,.md

# Chunk size for document processing
CHUNK_SIZE=100

# Chunk overlap in tokens
CHUNK_OVERLAP=15

# ============================================
# FastAPI Configuration
# ============================================

# FastAPI application host
FASTAPI_HOST=0.0.0.0

# FastAPI application port
FASTAPI_PORT=8000

# ============================================
# Streamlit Configuration
# ============================================

# Streamlit application host
STREAMLIT_HOST=localhost

# Streamlit application port
STREAMLIT_PORT=8501
